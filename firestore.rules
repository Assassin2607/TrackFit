rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function isValidDateKey(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             data.age is int && data.age >= 13 && data.age <= 120 &&
             data.gender is string && data.gender in ['MALE', 'FEMALE', 'OTHER'] &&
             isNumber(data.heightCm) && data.heightCm >= 100 && data.heightCm <= 250 &&
             isNumber(data.currentWeightKg) && data.currentWeightKg >= 25 && data.currentWeightKg <= 350 &&
             isNumber(data.goalWeightKg) && data.goalWeightKg >= 25 && data.goalWeightKg <= 350 &&
             data.goalType is string && data.goalType in ['CUT', 'BULK', 'MAINTAIN'] &&
             data.activityLevel is string && data.activityLevel in ['SEDENTARY', 'LIGHT', 'MODERATE', 'ACTIVE', 'VERY_ACTIVE'] &&
             data.trainingDaysPerWeek is int && data.trainingDaysPerWeek >= 1 && data.trainingDaysPerWeek <= 7 &&
             data.preferredSplit is string && data.preferredSplit in ['PPL', 'UPPER_LOWER', 'BRO_SPLIT', 'FULL_BODY', 'CUSTOM'] &&
             isNumber(data.targetRateKgPerWeek) && data.targetRateKgPerWeek >= 0 && data.targetRateKgPerWeek <= 1.5 &&
             data.calorieTarget is int && data.calorieTarget >= 1000 && data.calorieTarget <= 8000 &&
             data.proteinTargetG is int && data.proteinTargetG >= 30 && data.proteinTargetG <= 450 &&
             data.cardioTargetMinPerDay is int && data.cardioTargetMinPerDay >= 0 && data.cardioTargetMinPerDay <= 300 &&
             (!('waterTargetMl' in data) || (data.waterTargetMl is int && (data.waterTargetMl == 0 || (data.waterTargetMl >= 500 && data.waterTargetMl <= 10000)))) &&
             (!('unitSystem' in data) || (data.unitSystem is string && data.unitSystem in ['METRIC', 'IMPERIAL'])) &&
             data.onboardingCompleted is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserGoal(data) {
      return data.goalType is string && data.goalType in ['CUT', 'BULK', 'MAINTAIN'] &&
             isNumber(data.startingWeightKg) && data.startingWeightKg >= 25 && data.startingWeightKg <= 350 &&
             isNumber(data.targetWeightKg) && data.targetWeightKg >= 25 && data.targetWeightKg <= 350 &&
             isNumber(data.targetRateKgPerWeek) && data.targetRateKgPerWeek >= 0 && data.targetRateKgPerWeek <= 1.5 &&
             data.calorieTarget is int && data.calorieTarget >= 1000 && data.calorieTarget <= 8000 &&
             data.proteinTargetG is int && data.proteinTargetG >= 30 && data.proteinTargetG <= 450 &&
             data.active is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCustomExercise(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.muscleGroup is string && data.muscleGroup.size() >= 1 && data.muscleGroup.size() <= 40 &&
             (!('secondaryMuscles' in data) || (data.secondaryMuscles is string && data.secondaryMuscles.size() <= 120)) &&
             data.equipment is string && data.equipment.size() >= 1 && data.equipment.size() <= 50 &&
             data.difficulty is string && data.difficulty.size() >= 1 && data.difficulty.size() <= 30 &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 500)) &&
             data.custom is bool &&
             data.favorite is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWorkoutTemplate(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 250 &&
             data.exercises is list && data.exercises.size() <= 30 &&
             (data.exercises.size() == 0 || data.exercises[0] is map) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWorkoutSession(data) {
      return (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128)) &&
             data.templateName is string && data.templateName.size() >= 1 && data.templateName.size() <= 80 &&
             isValidDateKey(data.dateKey) &&
             data.startedAtEpochMs is int && data.startedAtEpochMs > 0 &&
             data.completedAtEpochMs is int && data.completedAtEpochMs >= 0 &&
             data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 600 &&
             isNumber(data.totalVolumeKg) && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 500000 &&
             data.estimatedCalories is int && data.estimatedCalories >= 0 && data.estimatedCalories <= 5000 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.sets is list && data.sets.size() <= 200 &&
             (data.sets.size() == 0 || data.sets[0] is map) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCardioSession(data) {
      return data.activityType is string && data.activityType.size() >= 1 && data.activityType.size() <= 40 &&
             isValidDateKey(data.dateKey) &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
             isNumber(data.distanceKm) && data.distanceKm >= 0 && data.distanceKm <= 500 &&
             isNumber(data.speedKmh) && data.speedKmh >= 0 && data.speedKmh <= 100 &&
             isNumber(data.inclinePercent) && data.inclinePercent >= 0 && data.inclinePercent <= 45 &&
             data.resistanceLevel is int && data.resistanceLevel >= 0 && data.resistanceLevel <= 50 &&
             data.caloriesEstimated is int && data.caloriesEstimated >= 0 && data.caloriesEstimated <= 6000 &&
             data.startedAtEpochMs is int && data.startedAtEpochMs > 0 &&
             data.notes is string && data.notes.size() <= 300 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCustomFood(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.brand is string && data.brand.size() <= 80 &&
             isNumber(data.servingSize) && data.servingSize > 0 && data.servingSize <= 5000 &&
             data.servingUnit is string && data.servingUnit.size() >= 1 && data.servingUnit.size() <= 20 &&
             isNumber(data.calories) && data.calories >= 0 && data.calories <= 5000 &&
             isNumber(data.protein) && data.protein >= 0 && data.protein <= 500 &&
             isNumber(data.carbs) && data.carbs >= 0 && data.carbs <= 1000 &&
             isNumber(data.fat) && data.fat >= 0 && data.fat <= 500 &&
             isNumber(data.fiber) && data.fiber >= 0 && data.fiber <= 200 &&
             data.favorite is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSavedMeal(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.mealType is string && data.mealType in ['BREAKFAST', 'LUNCH', 'DINNER', 'POST_WORKOUT', 'SNACK', 'CUSTOM'] &&
             data.items is list && data.items.size() <= 30 &&
             (data.items.size() == 0 || data.items[0] is map) &&
             isNumber(data.totalCalories) && data.totalCalories >= 0 && data.totalCalories <= 10000 &&
             isNumber(data.totalProtein) && data.totalProtein >= 0 && data.totalProtein <= 1000 &&
             isNumber(data.totalCarbs) && data.totalCarbs >= 0 && data.totalCarbs <= 2000 &&
             isNumber(data.totalFat) && data.totalFat >= 0 && data.totalFat <= 1000 &&
             isNumber(data.totalFiber) && data.totalFiber >= 0 && data.totalFiber <= 500 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFoodLog(data) {
      return data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 120 &&
             (!('foodItemId' in data) || (data.foodItemId is string && data.foodItemId.size() <= 128)) &&
             (!('mealId' in data) || (data.mealId is string && data.mealId.size() <= 128)) &&
             isNumber(data.quantity) && data.quantity > 0 && data.quantity <= 10000 &&
             data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
             isNumber(data.calories) && data.calories >= 0 && data.calories <= 10000 &&
             isNumber(data.protein) && data.protein >= 0 && data.protein <= 1000 &&
             isNumber(data.carbs) && data.carbs >= 0 && data.carbs <= 2000 &&
             isNumber(data.fat) && data.fat >= 0 && data.fat <= 1000 &&
             isNumber(data.fiber) && data.fiber >= 0 && data.fiber <= 500 &&
             data.mealType is string && data.mealType in ['BREAKFAST', 'LUNCH', 'DINNER', 'POST_WORKOUT', 'SNACK', 'CUSTOM'] &&
             isValidDateKey(data.dateKey) &&
             data.loggedAtEpochMs is int && data.loggedAtEpochMs > 0 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWaterLog(data) {
      return data.amountMl is int && data.amountMl >= 1 && data.amountMl <= 5000 &&
             isValidDateKey(data.dateKey) &&
             data.loggedAtEpochMs is int && data.loggedAtEpochMs > 0 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWeightLog(data) {
      return isNumber(data.weightKg) && data.weightKg >= 25 && data.weightKg <= 350 &&
             isValidDateKey(data.dateKey) &&
             data.recordedAtEpochMs is int && data.recordedAtEpochMs > 0 &&
             data.note is string && data.note.size() <= 200 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBodyMeasurement(data) {
      return isValidDateKey(data.dateKey) &&
             data.recordedAtEpochMs is int && data.recordedAtEpochMs > 0 &&
             (!('waistCm' in data) || (isNumber(data.waistCm) && data.waistCm >= 30 && data.waistCm <= 250)) &&
             (!('chestCm' in data) || (isNumber(data.chestCm) && data.chestCm >= 40 && data.chestCm <= 250)) &&
             (!('armsCm' in data) || (isNumber(data.armsCm) && data.armsCm >= 15 && data.armsCm <= 100)) &&
             (!('thighsCm' in data) || (isNumber(data.thighsCm) && data.thighsCm >= 25 && data.thighsCm <= 150)) &&
             (!('neckCm' in data) || (isNumber(data.neckCm) && data.neckCm >= 20 && data.neckCm <= 80)) &&
             (!('hipsCm' in data) || (isNumber(data.hipsCm) && data.hipsCm >= 40 && data.hipsCm <= 250)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProgressPhoto(data) {
      return data.photoType is string && data.photoType in ['FRONT', 'SIDE', 'BACK'] &&
             isValidDateKey(data.dateKey) &&
             data.recordedAtEpochMs is int && data.recordedAtEpochMs > 0 &&
             data.note is string && data.note.size() <= 200 &&
             data.localFileName is string && data.localFileName.size() >= 1 && data.localFileName.size() <= 160 &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'name', 'age', 'gender', 'heightCm', 'currentWeightKg',
          'goalWeightKg', 'goalType', 'activityLevel', 'trainingDaysPerWeek',
          'preferredSplit', 'targetRateKgPerWeek', 'calorieTarget', 'proteinTargetG',
          'cardioTargetMinPerDay', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'name', 'email', 'age', 'gender', 'heightCm', 'currentWeightKg',
          'goalWeightKg', 'goalType', 'activityLevel', 'trainingDaysPerWeek',
          'preferredSplit', 'targetRateKgPerWeek', 'calorieTarget', 'proteinTargetG',
          'cardioTargetMinPerDay', 'waterTargetMl', 'unitSystem', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'email', 'age', 'gender', 'heightCm', 'currentWeightKg',
          'goalWeightKg', 'goalType', 'activityLevel', 'trainingDaysPerWeek',
          'preferredSplit', 'targetRateKgPerWeek', 'calorieTarget', 'proteinTargetG',
          'cardioTargetMinPerDay', 'waterTargetMl', 'unitSystem', 'onboardingCompleted', 'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Historical Goals
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(goalId) &&
          incoming().keys().hasAll([
            'goalType', 'startingWeightKg', 'targetWeightKg', 'targetRateKgPerWeek',
            'calorieTarget', 'proteinTargetG', 'active', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'goalType', 'startingWeightKg', 'targetWeightKg', 'targetRateKgPerWeek',
            'calorieTarget', 'proteinTargetG', 'active', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidUserGoal(incoming());

        allow update: if isOwner(userId) && isValidId(goalId) &&
          isValidUserGoal(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'goalType', 'startingWeightKg', 'targetWeightKg', 'targetRateKgPerWeek',
            'calorieTarget', 'proteinTargetG', 'active', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Custom Exercises
      match /exercises/{exerciseId} {
        allow get: if isOwner(userId) && isValidId(exerciseId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(exerciseId) &&
          incoming().keys().hasAll(['name', 'muscleGroup', 'equipment', 'difficulty', 'custom', 'favorite', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['name', 'muscleGroup', 'secondaryMuscles', 'equipment', 'difficulty', 'instructions', 'custom', 'favorite', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidCustomExercise(incoming());

        allow update: if isOwner(userId) && isValidId(exerciseId) &&
          isValidCustomExercise(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'muscleGroup', 'secondaryMuscles', 'equipment', 'difficulty', 'instructions', 'custom', 'favorite', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(exerciseId);
      }

      // Workout Templates
      match /templates/{templateId} {
        allow get: if isOwner(userId) && isValidId(templateId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(templateId) &&
          incoming().keys().hasAll(['name', 'description', 'exercises', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['name', 'description', 'exercises', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidWorkoutTemplate(incoming());

        allow update: if isOwner(userId) && isValidId(templateId) &&
          isValidWorkoutTemplate(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'exercises', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(templateId);
      }

      // Workout Sessions
      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(workoutId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(workoutId) &&
          incoming().keys().hasAll([
            'templateName', 'dateKey', 'startedAtEpochMs', 'completedAtEpochMs',
            'durationMinutes', 'totalVolumeKg', 'estimatedCalories', 'notes', 'sets',
            'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'templateId', 'templateName', 'dateKey', 'startedAtEpochMs', 'completedAtEpochMs',
            'durationMinutes', 'totalVolumeKg', 'estimatedCalories', 'notes', 'sets',
            'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidWorkoutSession(incoming());

        allow update: if isOwner(userId) && isValidId(workoutId) &&
          isValidWorkoutSession(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'templateId', 'templateName', 'dateKey', 'startedAtEpochMs', 'completedAtEpochMs',
            'durationMinutes', 'totalVolumeKg', 'estimatedCalories', 'notes', 'sets', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // Cardio Sessions
      match /cardio/{cardioId} {
        allow get: if isOwner(userId) && isValidId(cardioId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(cardioId) &&
          incoming().keys().hasAll([
            'activityType', 'dateKey', 'durationMinutes', 'distanceKm', 'speedKmh',
            'inclinePercent', 'resistanceLevel', 'caloriesEstimated', 'startedAtEpochMs',
            'notes', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'activityType', 'dateKey', 'durationMinutes', 'distanceKm', 'speedKmh',
            'inclinePercent', 'resistanceLevel', 'caloriesEstimated', 'startedAtEpochMs',
            'notes', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidCardioSession(incoming());

        allow update: if isOwner(userId) && isValidId(cardioId) &&
          isValidCardioSession(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'activityType', 'dateKey', 'durationMinutes', 'distanceKm', 'speedKmh',
            'inclinePercent', 'resistanceLevel', 'caloriesEstimated', 'startedAtEpochMs',
            'notes', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(cardioId);
      }

      // Custom Foods
      match /custom_foods/{foodId} {
        allow get: if isOwner(userId) && isValidId(foodId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(foodId) &&
          incoming().keys().hasAll([
            'name', 'brand', 'servingSize', 'servingUnit', 'calories',
            'protein', 'carbs', 'fat', 'fiber', 'favorite', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'name', 'brand', 'servingSize', 'servingUnit', 'calories',
            'protein', 'carbs', 'fat', 'fiber', 'favorite', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidCustomFood(incoming());

        allow update: if isOwner(userId) && isValidId(foodId) &&
          isValidCustomFood(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'brand', 'servingSize', 'servingUnit', 'calories',
            'protein', 'carbs', 'fat', 'fiber', 'favorite', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(foodId);
      }

      // Saved Meals
      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(mealId) &&
          incoming().keys().hasAll([
            'name', 'mealType', 'items', 'totalCalories', 'totalProtein',
            'totalCarbs', 'totalFat', 'totalFiber', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'name', 'mealType', 'items', 'totalCalories', 'totalProtein',
            'totalCarbs', 'totalFat', 'totalFiber', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidSavedMeal(incoming());

        allow update: if isOwner(userId) && isValidId(mealId) &&
          isValidSavedMeal(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'mealType', 'items', 'totalCalories', 'totalProtein',
            'totalCarbs', 'totalFat', 'totalFiber', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // Food Logs
      match /food_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(logId) &&
          incoming().keys().hasAll([
            'foodName', 'quantity', 'unit', 'calories', 'protein', 'carbs', 'fat',
            'fiber', 'mealType', 'dateKey', 'loggedAtEpochMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'foodName', 'foodItemId', 'mealId', 'quantity', 'unit', 'calories', 'protein',
            'carbs', 'fat', 'fiber', 'mealType', 'dateKey', 'loggedAtEpochMs', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidFoodLog(incoming());

        allow update: if isOwner(userId) && isValidId(logId) &&
          isValidFoodLog(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'foodName', 'foodItemId', 'mealId', 'quantity', 'unit', 'calories', 'protein',
            'carbs', 'fat', 'fiber', 'mealType', 'dateKey', 'loggedAtEpochMs', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Water Logs
      match /water_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(logId) &&
          incoming().keys().hasAll(['amountMl', 'dateKey', 'loggedAtEpochMs', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['amountMl', 'dateKey', 'loggedAtEpochMs', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidWaterLog(incoming());

        allow update: if isOwner(userId) && isValidId(logId) &&
          isValidWaterLog(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['amountMl', 'dateKey', 'loggedAtEpochMs', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Weight Logs
      match /weight_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(logId) &&
          incoming().keys().hasAll(['weightKg', 'dateKey', 'recordedAtEpochMs', 'note', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['weightKg', 'dateKey', 'recordedAtEpochMs', 'note', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidWeightLog(incoming());

        allow update: if isOwner(userId) && isValidId(logId) &&
          isValidWeightLog(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'dateKey', 'recordedAtEpochMs', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Body Measurements
      match /measurements/{measurementId} {
        allow get: if isOwner(userId) && isValidId(measurementId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(measurementId) &&
          incoming().keys().hasAll(['dateKey', 'recordedAtEpochMs', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly([
            'dateKey', 'recordedAtEpochMs', 'waistCm', 'chestCm', 'armsCm',
            'thighsCm', 'neckCm', 'hipsCm', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidBodyMeasurement(incoming());

        allow update: if isOwner(userId) && isValidId(measurementId) &&
          isValidBodyMeasurement(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'recordedAtEpochMs', 'waistCm', 'chestCm', 'armsCm',
            'thighsCm', 'neckCm', 'hipsCm', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(measurementId);
      }

      // Progress Photo Metadata
      match /progress_photos/{photoId} {
        allow get: if isOwner(userId) && isValidId(photoId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(photoId) &&
          incoming().keys().hasAll(['photoType', 'dateKey', 'recordedAtEpochMs', 'note', 'localFileName', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['photoType', 'dateKey', 'recordedAtEpochMs', 'note', 'localFileName', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidProgressPhoto(incoming());

        allow update: if isOwner(userId) && isValidId(photoId) &&
          isValidProgressPhoto(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['photoType', 'dateKey', 'recordedAtEpochMs', 'note', 'localFileName', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(photoId);
      }
    }
  }
}
